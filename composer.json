{
    "name": "chabjose/cfdi-generator",
    "description": "Generador de CFDI 4.0 (Comprobante Fiscal Digital por Internet) para México, independiente de framework, con sellado digital incluido.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cfdi",
        "cfdi 4.0",
        "sat",
        "factura",
        "facturacion",
        "mexico",
        "xml",
        "sello digital",
        "csd"
    ],
    "authors": [
        {
            "name": "Jose Chab",
            "homepage": "https://github.com/Chab-Jose"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-xsl": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ChabJose\\CfdiGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChabJose\\CfdiGenerator\\Tests\\": "tests/"
        }
    },
      
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
